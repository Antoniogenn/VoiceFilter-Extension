{
  "manifest_version": 2,
  "name": "Voice Live",
  "version": "1.0.0",
  "description": "Rileva in tempo reale chi sta parlando in un video (genere e voce)",
  "permissions": [
    "storage",
    "*://*.youtube.com/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*"
  ],
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content/youtube-live.js"],
    "run_at": "document_idle"
  }],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Voice Live",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "web_accessible_resources": [
    "worklet.js"
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
